pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  # DNS가 없는 내부망 환경을 위한 설정
  hostAliases:
  - ip: "192.168.1.13"  # 실제 Harbor 서버 IP로 반드시 수정하세요!
    hostnames:
    - "harbor.test.com"
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ["sleep"]
    args: ["99d"]
    volumeMounts:
      - name: kaniko-secret
        mountPath: /kaniko/.docker
  volumes:
    - name: kaniko-secret
      projected:
        sources:
          - secret:
              name: harbor-ingress-tls # 생성하신 docker-registry 타입의 Secret 이름
              items:
                - key: .dockerconfigjson
                  path: config.json
"""
        }
    }

    environment {
        // Harbor 정보 설정
        REGISTRY = "harbor.test.com"
        PROJECT  = "test-project"
        IMAGE    = "nginx-test"
    }

    stages {
        stage('Build and Push to Harbor') {
            steps {
                container('kaniko') {
                    // Jenkins Credentials에서 ID가 'harbor-creds'인 정보를 가져옴
                    withCredentials([usernamePassword(credentialsId: 'harbor-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                        sh """
                        /kaniko/executor --context `pwd` \
                            --dockerfile `pwd`/dockerfile/Dockerfile \
                            --destination ${REGISTRY}/${PROJECT}/${IMAGE}:latest \
                            --insecure \
                            --skip-tls-verify
                        """
                    }
                }
            }
      
 }
    stage('Update Remote Manifest') {
    steps {
        // 1. 배포용 레포지토리를 SSH 주소로 클론 (git-creds는 SSH Private Key여야 함)
        dir('deploy-repo') {
            git url: 'git@git.test.com:user/nginx-deploy.git',
                branch: 'main',
                credentialsId: 'git-creds'
            
            script {
                sh """
                # 2. YAML 파일 내 이미지 태그 업데이트
                # sed 구분자를 | 로 사용해 URL 내 슬래시와 충돌 방지
                sed -i "s|${REGISTRY}/${PROJECT}/${IMAGE}:.*|${REGISTRY}/${PROJECT}/${IMAGE}:${env.BUILD_NUMBER}|g" manifests/deployment.yaml
                
                # 3. 변경 사항이 있을 때만 Push
                if [ -n "\$(git status --porcelain)" ]; then
                    git config user.email "jenkins@test.com"
                    git config user.name "jenkins"
                    
                    git add manifests/deployment.yaml
                    git commit -m "chore: update image tag to ${env.BUILD_NUMBER} [skip ci]"
                    
                    # SSH Key를 사용하므로 추가 인증 없이 바로 push 가능
                    git push origin main
                else
                    echo "No changes detected. Manifest is already up to date."
                fi
                """
            }
        }
    }
}
}
    
    post {
        success {
            echo "Successfully pushed ${IMAGE}:${env.BUILD_NUMBER} to Harbor!"
        }
        failure {
            echo "Build or Push failed. Please check the logs."
        }
    }
}
